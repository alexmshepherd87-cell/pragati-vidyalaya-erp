rules_version = '2';

// Security rules for Pragati Vidyalaya ERP.
// Class data lives under schools/{schoolId}/kv/{docId} and is readable/writable
// only by SIGNED-IN teacher accounts. Everything else is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    match /schools/{schoolId}/kv/{docId} {
      allow read, write: if request.auth != null;
    }

    // Deny all other paths by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
